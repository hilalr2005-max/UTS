
<?php

// ==========================================
// CLASS INDUK: PERPUSTAKAAN
// ==========================================
class Perpustakaan {
    protected $judul;
    protected $penulis;
    protected $tahun;
    protected $stok;

    public function __construct($judul, $penulis, $tahun, $stok) {
        $this->judul = $judul;
        $this->penulis = $penulis;
        $this->tahun = $tahun;
        $this->stok = $stok;
    }

    public function getJudul() {
        return $this->judul;
    }

    public function getPenulis() {
        return $this->penulis;
    }

    public function getTahun() {
        return $this->tahun;
    }

    public function getStok() {
        return $this->stok;
    }
}

// ==========================================
// CLASS ANAK 1: BUKU FIKSI
// ==========================================
class BukuFiksi extends Perpustakaan {
    private $genre;

    public function __construct($judul, $penulis, $tahun, $stok, $genre) {
        parent::__construct($judul, $penulis, $tahun, $stok);
        $this->genre = $genre;
    }

    public function getGenre() {
        return $this->genre;
    }
}

// ==========================================
// CLASS ANAK 2: BUKU NONFIKSI
// ==========================================
class BukuNonFiksi extends Perpustakaan {
    private $kategori;

    public function __construct($judul, $penulis, $tahun, $stok, $kategori) {
        parent::__construct($judul, $penulis, $tahun, $stok);
        $this->kategori = $kategori;
    }

    public function getKategori() {
        return $this->kategori;
    }
}

// ==========================================
// MEMBUAT OBJECT BUKU FIKSI
// ==========================================
$buku1 = new BukuFiksi(
    "Laskar Pelangi",
    "Andrea Hirata",
    2005,
    5,
    "Novel"
);

$buku2 = new BukuFiksi(
    "Bumi",
    "Tere Liye",
    2014,
    3,
    "Fantasi"
);

$buku3 = new BukuFiksi(
    "Dilan 1990",
    "Pidi Baiq",
    2014,
    4,
    "Romansa"
);

// ==========================================
// MEMBUAT OBJECT BUKU NONFIKSI
// ==========================================
$buku4 = new BukuNonFiksi(
    "Atomic Habits",
    "James Clear",
    2018,
    6,
    "Pengembangan Diri"
);

$buku5 = new BukuNonFiksi(
    "Filosofi Teras",
    "Henry Manampiring",
    2018,
    4,
    "Filsafat"
);

$buku6 = new BukuNonFiksi(
    "Sapiens",
    "Yuval Noah Harari",
    2011,
    2,
    "Sejarah"
);

// Mengelompokkan data buku
$daftarFiksi = [$buku1, $buku2, $buku3];
$daftarNonFiksi = [$buku4, $buku5, $buku6];

$totalBuku = count($daftarFiksi) + count($daftarNonFiksi);

$totalStok = 0;

foreach (array_merge($daftarFiksi, $daftarNonFiksi) as $buku) {
    $totalStok += $buku->getStok();
}

?>

